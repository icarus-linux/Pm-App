import json
import os
import re
import shutil
import subprocess
import sys
import tkinter as tk
import tkinter.font as tkfont
from tkinter import ttk, filedialog, messagebox, simpledialog
from pathlib import Path

try:
    from tkinterdnd2 import DND_FILES, TkinterDnD
    DND_AVAILABLE = True
except ImportError:
    DND_AVAILABLE = False

CONFIG_FILE = Path.home() / ".pm_workspace_config.json"
TEXT_EXTENSIONS = {".txt", ".md"}
IMAGE_EXTENSIONS = {".png", ".jpg", ".jpeg", ".gif", ".bmp"}
URL_RE = re.compile(r'(https?://\S+|www\.\S+)')

HELP_TEXT = {
    "workspaces": (
        "Workspaces\n\n"
        "A workspace is any folder on your computer. Each workspace can hold many "
        "product groups. Use 'Open Other Folder...' to add a new workspace, or "
        "double-click a recent one to open it. Switching workspaces here lets you "
        "keep multiple unrelated projects completely separate."
    ),
    "products": (
        "Products panel\n\n"
        "Each top-level item is a product or a group (e.g. 'SPAR'). Groups can "
        "contain sub-products (e.g. 'Eggs', 'Bacon') nested underneath them, to "
        "any depth. Right-click for New / Rename / Delete, or use the buttons. "
        "Dropping files here (if drag-and-drop is enabled) adds them to that item."
    ),
    "files": (
        "Files panel\n\n"
        "Shows the files inside whichever product or sub-product is selected on "
        "the left. Right-click for New / Add / Rename / Delete. Dropping files "
        "here (if enabled) copies them into the selected product."
    ),
    "preview": (
        "Preview / editor\n\n"
        ".txt and .md files open in the editor, where you can apply Bold, "
        "Italic and Underline, and web links are auto-highlighted in blue. "
        "Images preview inline. Other file types can't preview here — use "
        "'Open in Default App'."
    ),
}


def load_config():
    if CONFIG_FILE.exists():
        try:
            return json.loads(CONFIG_FILE.read_text())
        except Exception:
            return {}
    return {}


def save_config(data):
    try:
        CONFIG_FILE.write_text(json.dumps(data, indent=2))
    except Exception:
        pass  # non-fatal: worst case, state isn't remembered next launch


def sidecar_path(file_path: Path) -> Path:
    return file_path.with_suffix(file_path.suffix + ".fmt.json")


BaseTk = TkinterDnD.Tk if DND_AVAILABLE else tk.Tk


class WorkspaceApp(BaseTk):
    def __init__(self):
        super().__init__()
        self.title("Product Workspace")
        self.geometry("1080x680")
        self.minsize(780, 480)

        self.config_data = load_config()
        self.workspace_path = None
        self.current_rel_dir = None   # relative path (posix str) of selected product/sub-product, "" = workspace root
        self.current_file = None
        self.text_dirty = False

        self._build_selector_ui()
        self._build_workspace_ui()

        self.protocol("WM_DELETE_WINDOW", self.on_close)
        self.show_selector()

    # ================= Landing page: choose / switch workspace =================
    def _build_selector_ui(self):
        self.selector_frame = ttk.Frame(self, padding=24)

        header = ttk.Frame(self.selector_frame)
        header.pack(fill="x", pady=(0, 12))
        ttk.Label(header, text="Product Workspaces", font=("", 16, "bold")).pack(side="left")
        self._help_button(header, "workspaces").pack(side="left", padx=6)

        self.recent_list = tk.Listbox(self.selector_frame, height=12)
        self.recent_list.pack(fill="both", expand=True, pady=6)
        self.recent_list.bind("<Double-Button-1>", lambda e: self.open_selected_recent())

        btns = ttk.Frame(self.selector_frame)
        btns.pack(fill="x", pady=(6, 0))
        ttk.Button(btns, text="Open", command=self.open_selected_recent).pack(side="left")
        ttk.Button(btns, text="Open Other Folder...", command=self.choose_workspace).pack(side="left", padx=6)
        ttk.Button(btns, text="Remove From List", command=self.remove_recent).pack(side="left")

    def refresh_recent_list(self):
        self.recent_list.delete(0, "end")
        for ws in self.config_data.get("recent_workspaces", []):
            self.recent_list.insert("end", ws)

    def show_selector(self):
        if not self._confirm_discard_if_dirty():
            return
        self.workspace_frame.pack_forget()
        self.title("Product Workspace")
        self.refresh_recent_list()
        self.selector_frame.pack(fill="both", expand=True)

    def open_selected_recent(self):
        sel = self.recent_list.curselection()
        if not sel:
            messagebox.showinfo("Pick one", "Select a workspace in the list first, or add a new folder.")
            return
        path = self.recent_list.get(sel[0])
        if not Path(path).exists():
            messagebox.showerror("Not found", "That folder no longer exists on disk.")
            return
        self.set_workspace(path)

    def remove_recent(self):
        sel = self.recent_list.curselection()
        if not sel:
            return
        path = self.recent_list.get(sel[0])
        recents = self.config_data.get("recent_workspaces", [])
        if path in recents:
            recents.remove(path)
        save_config(self.config_data)
        self.refresh_recent_list()

    def choose_workspace(self):
        path = filedialog.askdirectory(title="Choose a folder for your Product Workspace")
        if path:
            self.set_workspace(path)

    def set_workspace(self, path):
        self.workspace_path = Path(path)
        recents = self.config_data.setdefault("recent_workspaces", [])
        p = str(self.workspace_path)
        if p in recents:
            recents.remove(p)
        recents.insert(0, p)
        self.config_data["recent_workspaces"] = recents[:12]
        self.config_data["last_workspace"] = p
        save_config(self.config_data)

        self.workspace_label.config(text=p)
        self.current_rel_dir = None
        self.current_file = None
        self.refresh_tree()
        self.files_list.delete(0, "end")
        self.clear_preview()

        self.selector_frame.pack_forget()
        self.workspace_frame.pack(fill="both", expand=True)
        self.title(f"Product Workspace — {self.workspace_path.name}")

    # ================= Main workspace UI =================
    def _build_workspace_ui(self):
        self.workspace_frame = ttk.Frame(self)

        top = ttk.Frame(self.workspace_frame, padding=8)
        top.pack(side="top", fill="x")
        ttk.Button(top, text="\u2190 Switch Workspace", command=self.show_selector).pack(side="left")
        self.workspace_label = ttk.Label(top, text="", anchor="w")
        self.workspace_label.pack(side="left", fill="x", expand=True, padx=8)

        ttk.Button(top, text="Search...", command=self.open_search).pack(side="left", padx=4)
        ttk.Button(top, text="Backup Workspace...", command=self.export_workspace_zip).pack(side="left", padx=4)

        # View toggles (hide/show panels)
        self.show_products_var = tk.BooleanVar(value=True)
        self.show_files_var = tk.BooleanVar(value=True)
        ttk.Checkbutton(top, text="Products", variable=self.show_products_var,
                         command=self._apply_panel_visibility).pack(side="right", padx=4)
        ttk.Checkbutton(top, text="Files", variable=self.show_files_var,
                         command=self._apply_panel_visibility).pack(side="right", padx=4)

        if not DND_AVAILABLE:
            banner = ttk.Frame(self.workspace_frame, padding=(8, 4))
            banner.pack(side="top", fill="x")
            ttk.Label(
                banner,
                text=("Drag-and-drop from outside the app is off — the 'tkinterdnd2' package "
                      "isn't installed. Run: pip install tkinterdnd2  (then restart the app)."),
                foreground="#8a5a00",
            ).pack(side="left")

        self.main_paned = ttk.Panedwindow(self.workspace_frame, orient="horizontal")
        self.main_paned.pack(fill="both", expand=True)

        self._build_products_panel()
        self._build_files_panel()
        self._build_preview_panel()

        self.main_paned.add(self.products_frame, weight=1)
        self.main_paned.add(self.files_frame, weight=1)
        self.main_paned.add(self.preview_frame, weight=2)

    def _apply_panel_visibility(self):
        # Rebuild the paned window's panes based on checkbox state, preview always shown.
        for pane in self.main_paned.panes():
            self.main_paned.forget(pane)
        if self.show_products_var.get():
            self.main_paned.add(self.products_frame, weight=1)
        if self.show_files_var.get():
            self.main_paned.add(self.files_frame, weight=1)
        self.main_paned.add(self.preview_frame, weight=2)

    def _help_button(self, parent, key):
        return ttk.Button(parent, text="?", width=2,
                           command=lambda: messagebox.showinfo("Help", HELP_TEXT[key]))

    # ---------------- Products (nested tree) ----------------
    def _build_products_panel(self):
        self.products_frame = ttk.Frame(self.main_paned, padding=6)
        header = ttk.Frame(self.products_frame)
        header.pack(fill="x")
        ttk.Label(header, text="Products", font=("", 10, "bold")).pack(side="left")
        self._help_button(header, "products").pack(side="left", padx=4)

        self.tree = ttk.Treeview(self.products_frame, show="tree")
        self.tree.pack(fill="both", expand=True, pady=4)
        self.tree.bind("<<TreeviewSelect>>", self.on_select_product)
        self.tree.bind("<Button-3>", self.on_tree_right_click)
        self.tree.bind("<Button-2>", self.on_tree_right_click)  # some trackpads/macs

        pbtns = ttk.Frame(self.products_frame)
        pbtns.pack(fill="x")
        ttk.Button(pbtns, text="+ Group/Product", command=self.new_top_level_product).pack(side="left", expand=True, fill="x")
        ttk.Button(pbtns, text="+ Sub", command=self.new_subfolder).pack(side="left", expand=True, fill="x")
        ttk.Button(pbtns, text="Rename", command=self.rename_product_node).pack(side="left", expand=True, fill="x")
        ttk.Button(pbtns, text="Delete", command=self.delete_product_node).pack(side="left", expand=True, fill="x")

        if DND_AVAILABLE:
            self.tree.drop_target_register(DND_FILES)
            self.tree.dnd_bind("<<Drop>>", self.on_drop_into_tree)

    def refresh_tree(self):
        self.tree.delete(*self.tree.get_children())
        if not self.workspace_path:
            return
        self._insert_tree_children("", self.workspace_path)

    def _insert_tree_children(self, parent_iid, dir_path):
        try:
            entries = sorted(dir_path.iterdir(), key=lambda e: e.name.lower())
        except FileNotFoundError:
            return
        for entry in entries:
            if entry.is_dir():
                rel = entry.relative_to(self.workspace_path).as_posix()
                self.tree.insert(parent_iid, "end", iid=rel, text=entry.name, open=False)
                self._insert_tree_children(rel, entry)

    def _selected_rel_dir(self):
        sel = self.tree.selection()
        return sel[0] if sel else None

    def _confirm_discard_if_dirty(self):
        """If the current file has unsaved edits, ask before we blow them away.
        Returns False if the switch should be aborted (user chose Cancel)."""
        if not self.text_dirty or not self.current_file:
            return True
        answer = messagebox.askyesnocancel(
            "Unsaved changes",
            f"Save changes to '{self.current_file}' before switching?",
        )
        if answer is None:  # Cancel
            return False
        if answer:  # Yes
            self.save_current_file()
        else:  # No — discard
            self.text_dirty = False
        return True

    def on_select_product(self, event=None):
        rel = self._selected_rel_dir()
        if rel is None:
            return
        if rel == self.current_rel_dir:
            return
        if not self._confirm_discard_if_dirty():
            # Put the tree selection back to the product that's still open,
            # since the user chose not to switch after all.
            if self.current_rel_dir and self.tree.exists(self.current_rel_dir):
                self.tree.selection_set(self.current_rel_dir)
            return
        self.current_rel_dir = rel
        self.config_data["last_dir"] = rel
        save_config(self.config_data)
        self.refresh_files()
        self.clear_preview()

    def new_top_level_product(self):
        if not self.workspace_path:
            messagebox.showwarning("No workspace", "Choose a workspace first.")
            return
        name = simpledialog.askstring("New Product / Group", "Name:")
        if not name:
            return
        new_dir = self.workspace_path / name
        try:
            new_dir.mkdir(exist_ok=False)
        except FileExistsError:
            messagebox.showerror("Error", "Something with that name already exists at the top level.")
            return
        self.refresh_tree()

    def new_subfolder(self):
        rel = self._selected_rel_dir()
        if rel is None:
            messagebox.showwarning("No selection", "Select a product or group first.")
            return
        name = simpledialog.askstring("New Sub-Product", "Name:")
        if not name:
            return
        parent_dir = self.workspace_path / rel
        new_dir = parent_dir / name
        try:
            new_dir.mkdir(exist_ok=False)
        except FileExistsError:
            messagebox.showerror("Error", "Something with that name already exists there.")
            return
        self.refresh_tree()
        self.tree.item(rel, open=True)

    def rename_product_node(self, rel=None):
        rel = rel or self._selected_rel_dir()
        if rel is None:
            messagebox.showwarning("No selection", "Select a product or group first.")
            return
        old_path = self.workspace_path / rel
        new_name = simpledialog.askstring("Rename", "New name:", initialvalue=old_path.name)
        if not new_name or new_name == old_path.name:
            return
        new_path = old_path.parent / new_name
        if new_path.exists():
            messagebox.showerror("Error", "Something with that name already exists there.")
            return
        old_path.rename(new_path)
        new_rel = new_path.relative_to(self.workspace_path).as_posix()

        # If the renamed folder was open (or was an ancestor of the open
        # folder), current_rel_dir points at a path that no longer exists.
        # Rewrite it to the new location so Add/New/Delete keep working.
        if self.current_rel_dir is not None and (
            self.current_rel_dir == rel or self.current_rel_dir.startswith(rel + "/")
        ):
            self.current_rel_dir = new_rel + self.current_rel_dir[len(rel):]

        self.refresh_tree()
        if self.current_rel_dir is not None and self.tree.exists(self.current_rel_dir):
            self._reveal_tree_ancestors(self.current_rel_dir)
            self.tree.selection_set(self.current_rel_dir)

    def delete_product_node(self, rel=None):
        rel = rel or self._selected_rel_dir()
        if rel is None:
            return
        name = self.workspace_path.joinpath(rel).name
        if messagebox.askyesno("Delete", f"Delete '{name}' and everything inside it? This cannot be undone."):
            shutil.rmtree(self.workspace_path / rel)
            if self.current_rel_dir == rel:
                self.current_rel_dir = None
                self.files_list.delete(0, "end")
                self.clear_preview()
            self.refresh_tree()

    def on_tree_right_click(self, event):
        iid = self.tree.identify_row(event.y)
        menu = tk.Menu(self, tearoff=0)
        if iid:
            self.tree.selection_set(iid)
            menu.add_command(label="New Sub-Product...", command=self.new_subfolder)
            menu.add_command(label="Rename...", command=lambda: self.rename_product_node(iid))
            menu.add_command(label="Delete", command=lambda: self.delete_product_node(iid))
        else:
            menu.add_command(label="New Group/Product...", command=self.new_top_level_product)
        menu.tk_popup(event.x_root, event.y_root)

    def on_drop_into_tree(self, event):
        iid = self.tree.identify_row(event.y) if hasattr(event, "y") else None
        target_rel = iid if iid else self.current_rel_dir
        if not target_rel:
            messagebox.showwarning("No target", "Drop the file onto a specific product/group.")
            return
        dest_dir = self.workspace_path / target_rel
        for p in self.tk.splitlist(event.data):
            try:
                shutil.copy(p, dest_dir / Path(p).name)
            except Exception as e:
                messagebox.showerror("Error copying file", str(e))
        if target_rel == self.current_rel_dir:
            self.refresh_files()

    # ---------------- Files ----------------
    def _build_files_panel(self):
        self.files_frame = ttk.Frame(self.main_paned, padding=6)
        header = ttk.Frame(self.files_frame)
        header.pack(fill="x")
        ttk.Label(header, text="Files", font=("", 10, "bold")).pack(side="left")
        self._help_button(header, "files").pack(side="left", padx=4)

        self.files_list = tk.Listbox(self.files_frame, exportselection=False)
        self.files_list.pack(fill="both", expand=True, pady=4)
        self.files_list.bind("<<ListboxSelect>>", self.on_select_file)
        self.files_list.bind("<Button-3>", self.on_files_right_click)
        self.files_list.bind("<Button-2>", self.on_files_right_click)

        fbtns = ttk.Frame(self.files_frame)
        fbtns.pack(fill="x")
        ttk.Button(fbtns, text="+ New .md/.txt", command=self.new_text_file).pack(side="left", expand=True, fill="x")
        ttk.Button(fbtns, text="Add File...", command=self.add_file).pack(side="left", expand=True, fill="x")
        ttk.Button(fbtns, text="Rename", command=self.rename_file).pack(side="left", expand=True, fill="x")
        ttk.Button(fbtns, text="Delete", command=self.delete_file).pack(side="left", expand=True, fill="x")

        if DND_AVAILABLE:
            self.files_list.drop_target_register(DND_FILES)
            self.files_list.dnd_bind("<<Drop>>", self.on_drop_into_files)

    def refresh_files(self):
        self.files_list.delete(0, "end")
        if self.current_rel_dir is None:
            return
        product_dir = self.workspace_path / self.current_rel_dir
        for entry in sorted(product_dir.iterdir(), key=lambda e: e.name.lower()):
            if entry.is_file() and not entry.name.endswith(".fmt.json"):
                self.files_list.insert("end", entry.name)

    def _require_product(self):
        if self.current_rel_dir is None:
            messagebox.showwarning("No product selected", "Select a product or sub-product first.")
            return False
        return True

    def new_text_file(self):
        if not self._require_product():
            return
        name = simpledialog.askstring("New File", "File name (e.g. notes.md or notes.txt):")
        if not name:
            return
        if not (name.endswith(".txt") or name.endswith(".md")):
            name += ".md"
        path = self.workspace_path / self.current_rel_dir / name
        if path.exists():
            messagebox.showerror("Error", "A file with that name already exists.")
            return
        path.write_text("")
        self.refresh_files()

    def add_file(self):
        if not self._require_product():
            return
        paths = filedialog.askopenfilenames(title="Add file(s) to product")
        if not paths:
            return
        dest_dir = self.workspace_path / self.current_rel_dir
        for p in paths:
            shutil.copy(p, dest_dir / Path(p).name)
        self.refresh_files()

    def rename_file(self, name=None):
        if not self._require_product():
            return
        name = name or self._selected_file_name()
        if not name:
            messagebox.showwarning("No selection", "Select a file first.")
            return
        old_path = self.workspace_path / self.current_rel_dir / name
        new_name = simpledialog.askstring("Rename File", "New name:", initialvalue=name)
        if not new_name or new_name == name:
            return
        new_path = old_path.parent / new_name
        if new_path.exists():
            messagebox.showerror("Error", "A file with that name already exists.")
            return
        old_path.rename(new_path)
        old_sidecar = sidecar_path(old_path)
        if old_sidecar.exists():
            old_sidecar.rename(sidecar_path(new_path))
        if self.current_file == name:
            self.current_file = new_name
            self.config_data["last_file"] = new_name
            save_config(self.config_data)
        self.refresh_files()

    def delete_file(self, name=None):
        if not self._require_product():
            return
        name = name or self._selected_file_name()
        if not name:
            return
        if messagebox.askyesno("Delete File", f"Delete '{name}'?"):
            path = self.workspace_path / self.current_rel_dir / name
            path.unlink()
            sc = sidecar_path(path)
            if sc.exists():
                sc.unlink()
            self.refresh_files()
            self.clear_preview()

    def _selected_file_name(self):
        sel = self.files_list.curselection()
        return self.files_list.get(sel[0]) if sel else None

    def on_select_file(self, event=None):
        name = self._selected_file_name()
        if not name:
            return
        if name == self.current_file:
            return
        if not self._confirm_discard_if_dirty():
            # Revert the listbox selection back to the file that's still open.
            items = list(self.files_list.get(0, "end"))
            if self.current_file in items:
                idx = items.index(self.current_file)
                self.files_list.selection_clear(0, "end")
                self.files_list.selection_set(idx)
            return
        self.current_file = name
        self.config_data["last_file"] = name
        save_config(self.config_data)
        self.load_preview(name)

    def on_files_right_click(self, event):
        idx = self.files_list.nearest(event.y)
        menu = tk.Menu(self, tearoff=0)
        if idx is not None and self.files_list.size() > 0:
            self.files_list.selection_clear(0, "end")
            self.files_list.selection_set(idx)
            name = self.files_list.get(idx)
            menu.add_command(label="Open", command=lambda: self.load_preview(name))
            menu.add_command(label="Rename...", command=lambda: self.rename_file(name))
            menu.add_command(label="Delete", command=lambda: self.delete_file(name))
            menu.add_separator()
        menu.add_command(label="New .md/.txt...", command=self.new_text_file)
        menu.add_command(label="Add File...", command=self.add_file)
        menu.tk_popup(event.x_root, event.y_root)

    def on_drop_into_files(self, event):
        if not self._require_product():
            return
        dest_dir = self.workspace_path / self.current_rel_dir
        for p in self.tk.splitlist(event.data):
            try:
                shutil.copy(p, dest_dir / Path(p).name)
            except Exception as e:
                messagebox.showerror("Error copying file", str(e))
        self.refresh_files()

    # ---------------- Preview / rich-text editing ----------------
    def _build_preview_panel(self):
        self.preview_frame = ttk.Frame(self.main_paned, padding=6)
        header = ttk.Frame(self.preview_frame)
        header.pack(fill="x")
        self.preview_label = ttk.Label(header, text="Select a file to preview or edit", font=("", 10, "bold"))
        self.preview_label.pack(side="left")
        self._help_button(header, "preview").pack(side="left", padx=4)

        style_bar = ttk.Frame(self.preview_frame)
        style_bar.pack(fill="x", pady=(4, 0))
        ttk.Button(style_bar, text="B", width=3, command=lambda: self.toggle_style("bold")).pack(side="left")
        ttk.Button(style_bar, text="I", width=3, command=lambda: self.toggle_style("italic")).pack(side="left", padx=2)
        ttk.Button(style_bar, text="U", width=3, command=lambda: self.toggle_style("underline")).pack(side="left")

        base_font = tkfont.Font(font=("TkDefaultFont", 11))
        bold_font = base_font.copy()
        bold_font.configure(weight="bold")
        italic_font = base_font.copy()
        italic_font.configure(slant="italic")
        bold_italic_font = base_font.copy()
        bold_italic_font.configure(weight="bold", slant="italic")

        self.text_editor = tk.Text(self.preview_frame, wrap="word", undo=True, font=base_font)
        self.text_editor.pack(fill="both", expand=True, pady=4)
        self.text_editor.tag_configure("bold", font=bold_font)
        self.text_editor.tag_configure("italic", font=italic_font)
        self.text_editor.tag_configure("bold_italic", font=bold_italic_font)
        self.text_editor.tag_configure("underline", underline=True)
        self.text_editor.tag_configure("link", foreground="blue", underline=True)
        self.text_editor.bind("<<Modified>>", self._on_text_modified)

        self.image_canvas_label = ttk.Label(self.preview_frame)

        save_bar = ttk.Frame(self.preview_frame)
        save_bar.pack(fill="x")
        self.save_btn = ttk.Button(save_bar, text="Save", command=self.save_current_file, state="disabled")
        self.save_btn.pack(side="left")
        ttk.Button(save_bar, text="Open in Default App", command=self.open_in_os).pack(side="left", padx=6)

    def toggle_style(self, tag):
        try:
            start, end = self.text_editor.index("sel.first"), self.text_editor.index("sel.last")
        except tk.TclError:
            return  # nothing selected

        if tag == "underline":
            # Underline doesn't touch the font, so it can freely combine with
            # bold and/or italic on the same text — plain add/remove is fine.
            current_tags = self.text_editor.tag_names("sel.first")
            if tag in current_tags:
                self.text_editor.tag_remove(tag, start, end)
            else:
                self.text_editor.tag_add(tag, start, end)
            self.text_dirty = True
            self.save_btn.config(state="normal")
            return

        # Bold and italic both need the "font" option, and Tk can only show one
        # font per character, so bold+italic together has to be its own tag
        # ("bold_italic") rather than two separate tags stacked on each other.
        # We walk the selection character-by-character, work out each
        # character's current bold/italic state, flip the one being toggled,
        # and re-tag it with whichever of the four combinations now applies.
        turn_on = not self._selection_fully_has(tag, start, end)
        idx = start
        while self.text_editor.compare(idx, "<", end):
            next_idx = f"{idx}+1c"
            char_tags = set(self.text_editor.tag_names(idx))
            has_bold = "bold" in char_tags or "bold_italic" in char_tags
            has_italic = "italic" in char_tags or "bold_italic" in char_tags
            if tag == "bold":
                has_bold = turn_on
            else:
                has_italic = turn_on
            for t in ("bold", "italic", "bold_italic"):
                self.text_editor.tag_remove(t, idx, next_idx)
            if has_bold and has_italic:
                self.text_editor.tag_add("bold_italic", idx, next_idx)
            elif has_bold:
                self.text_editor.tag_add("bold", idx, next_idx)
            elif has_italic:
                self.text_editor.tag_add("italic", idx, next_idx)
            idx = next_idx

        self.text_dirty = True
        self.save_btn.config(state="normal")

    def _selection_fully_has(self, style, start, end):
        """True if every character in [start, end) already has the given style
        (accounting for it being folded into the combined bold_italic tag)."""
        idx = start
        while self.text_editor.compare(idx, "<", end):
            char_tags = set(self.text_editor.tag_names(idx))
            has_bold = "bold" in char_tags or "bold_italic" in char_tags
            has_italic = "italic" in char_tags or "bold_italic" in char_tags
            current = has_bold if style == "bold" else has_italic
            if not current:
                return False
            idx = f"{idx}+1c"
        return True

    def _relink(self):
        self.text_editor.tag_remove("link", "1.0", "end")
        content = self.text_editor.get("1.0", "end-1c")
        for m in URL_RE.finditer(content):
            start = f"1.0+{m.start()}c"
            end = f"1.0+{m.end()}c"
            self.text_editor.tag_add("link", start, end)

    def _on_text_modified(self, event=None):
        if self.text_editor.edit_modified():
            self.text_dirty = True
            self.save_btn.config(state="normal")
            self._relink()
            self.text_editor.edit_modified(False)

    def load_preview(self, name):
        path = self.workspace_path / self.current_rel_dir / name
        ext = path.suffix.lower()
        self.preview_label.config(text=name)

        if ext in TEXT_EXTENSIONS:
            self.image_canvas_label.pack_forget()
            self.text_editor.pack(fill="both", expand=True, pady=4)
            self.text_editor.delete("1.0", "end")
            try:
                content = path.read_text(encoding="utf-8")
            except Exception:
                content = "(Unable to read file as text)"
            self.text_editor.insert("1.0", content)
            self._load_formatting(path)
            self._relink()
            self.text_editor.edit_modified(False)
            self.text_dirty = False
            self.save_btn.config(state="disabled")
        elif ext in IMAGE_EXTENSIONS:
            self.text_editor.pack_forget()
            self._show_image(path)
        else:
            self.image_canvas_label.pack_forget()
            self.text_editor.pack(fill="both", expand=True, pady=4)
            self.text_editor.delete("1.0", "end")
            self.text_editor.insert("1.0", f"(No inline preview for {ext} files. Use 'Open in Default App'.)")
            self.save_btn.config(state="disabled")

    def _load_formatting(self, path):
        sc = sidecar_path(path)
        if not sc.exists():
            return
        try:
            data = json.loads(sc.read_text())
        except Exception:
            return
        for tag in ("bold", "italic", "bold_italic", "underline"):
            for start, end in data.get(tag, []):
                self.text_editor.tag_add(tag, start, end)

    def _save_formatting(self, path):
        data = {}
        for tag in ("bold", "italic", "bold_italic", "underline"):
            ranges = self.text_editor.tag_ranges(tag)
            pairs = [[str(ranges[i]), str(ranges[i + 1])] for i in range(0, len(ranges), 2)]
            if pairs:
                data[tag] = pairs
        sc = sidecar_path(path)
        if data:
            sc.write_text(json.dumps(data))
        elif sc.exists():
            sc.unlink()

    def _show_image(self, path):
        try:
            from PIL import Image, ImageTk
        except ImportError:
            self.text_editor.pack(fill="both", expand=True, pady=4)
            self.text_editor.delete("1.0", "end")
            self.text_editor.insert("1.0", "(Install Pillow to preview images: pip install Pillow)")
            return
        img = Image.open(path)
        img.thumbnail((600, 500))
        photo = ImageTk.PhotoImage(img)
        self.image_canvas_label.image = photo
        self.image_canvas_label.config(image=photo)
        self.image_canvas_label.pack(fill="both", expand=True, pady=4)

    def save_current_file(self):
        if not self.current_file or self.current_rel_dir is None:
            return
        path = self.workspace_path / self.current_rel_dir / self.current_file
        content = self.text_editor.get("1.0", "end-1c")
        path.write_text(content, encoding="utf-8")
        self._save_formatting(path)
        self.text_dirty = False
        self.save_btn.config(state="disabled")

    def clear_preview(self):
        self.current_file = None
        self.text_dirty = False
        self.preview_label.config(text="Select a file to preview or edit")
        self.text_editor.pack(fill="both", expand=True, pady=4)
        self.image_canvas_label.pack_forget()
        self.text_editor.delete("1.0", "end")
        self.save_btn.config(state="disabled")

    def open_in_os(self):
        if not self.current_file or self.current_rel_dir is None:
            return
        path = self.workspace_path / self.current_rel_dir / self.current_file
        if sys.platform.startswith("darwin"):
            subprocess.call(("open", str(path)))
        elif os.name == "nt":
            os.startfile(str(path))
        else:
            subprocess.call(("xdg-open", str(path)))

    # ---------------- Search across the whole workspace ----------------
    def _search_workspace(self, query, max_results=200):
        """Scan every product/sub-product name, file name, and .txt/.md file's
        text content for `query` (case-insensitive). Returns a list of dicts
        describing each match, capped at max_results."""
        results = []
        query_l = query.lower()
        if not self.workspace_path or not query_l:
            return results

        for root, dirs, files in os.walk(self.workspace_path):
            root_path = Path(root)
            rel_root = "" if root_path == self.workspace_path else root_path.relative_to(self.workspace_path).as_posix()

            for d in sorted(dirs):
                if query_l in d.lower():
                    rel = f"{rel_root}/{d}" if rel_root else d
                    results.append({"type": "dir", "rel": rel, "label": f"\U0001F4C1 {rel}"})

            for f in sorted(files):
                if f.endswith(".fmt.json"):
                    continue
                rel_file = f"{rel_root}/{f}" if rel_root else f
                matched_name = query_l in f.lower()
                snippet = None
                if not matched_name and f.lower().endswith((".txt", ".md")):
                    fpath = root_path / f
                    try:
                        if fpath.stat().st_size <= 2_000_000:
                            content = fpath.read_text(encoding="utf-8", errors="ignore")
                            pos = content.lower().find(query_l)
                            if pos != -1:
                                start = max(0, pos - 25)
                                snippet = content[start:pos + len(query) + 25].replace("\n", " ")
                    except Exception:
                        pass
                if matched_name or snippet:
                    label = f"\U0001F4C4 {rel_file}"
                    if snippet:
                        label += f"   \u2026{snippet}\u2026"
                    results.append({
                        "type": "file", "rel_dir": rel_root, "name": f,
                        "rel": rel_file, "label": label,
                    })
                if len(results) >= max_results:
                    return results
        return results

    def _reveal_tree_ancestors(self, rel):
        parts = rel.split("/")
        acc = []
        for p in parts[:-1]:
            acc.append(p)
            node = "/".join(acc)
            if self.tree.exists(node):
                self.tree.item(node, open=True)

    def _select_tree_node(self, rel):
        """Select and reveal a tree node, letting the normal <<TreeviewSelect>>
        binding (on_select_product) do the actual work — this avoids invoking
        it a second time on top of Tk's own deferred event for the same click."""
        if not self.tree.exists(rel):
            messagebox.showinfo("Not found", "That item no longer exists — it may have been renamed or deleted.")
            return False
        self._reveal_tree_ancestors(rel)
        self.tree.selection_set(rel)
        self.tree.see(rel)
        return True

    def _reveal_and_select_file(self, rel_dir, filename):
        if not rel_dir:
            messagebox.showinfo("Can't open", "That file sits at the workspace root, outside any product folder.")
            return
        if not self._select_tree_node(rel_dir):
            return
        # The tree's own <<TreeviewSelect>> handler (which repopulates the
        # files list) is still pending at this point, so the file-selection
        # step has to wait until it has actually run.
        self.after_idle(lambda: self._finish_select_file(filename))

    def _finish_select_file(self, filename):
        items = list(self.files_list.get(0, "end"))
        if filename in items:
            idx = items.index(filename)
            self.files_list.selection_clear(0, "end")
            self.files_list.selection_set(idx)
            self.files_list.see(idx)
            self.on_select_file()
        else:
            messagebox.showinfo("Not found", "That file no longer exists — it may have been renamed or deleted.")

    def open_search(self):
        if not self.workspace_path:
            messagebox.showinfo("No workspace", "Open a workspace first.")
            return

        win = tk.Toplevel(self)
        win.title("Search Workspace")
        win.geometry("560x440")
        win.transient(self)

        ttk.Label(win, text="Searches product/group names, file names, and the text inside .md/.txt files:",
                  wraplength=520).pack(anchor="w", padx=10, pady=(10, 4))
        entry = ttk.Entry(win)
        entry.pack(fill="x", padx=10)
        entry.focus_set()

        results_list = tk.Listbox(win)
        results_list.pack(fill="both", expand=True, padx=10, pady=8)
        status = ttk.Label(win, text="Type to search...", foreground="#666666")
        status.pack(anchor="w", padx=10, pady=(0, 8))

        state = {"results": []}

        def do_search(event=None):
            q = entry.get().strip()
            results_list.delete(0, "end")
            if not q:
                status.config(text="Type to search...")
                state["results"] = []
                return
            res = self._search_workspace(q)
            state["results"] = res
            for r in res:
                results_list.insert("end", r["label"])
            if not res:
                status.config(text="No matches.")
            else:
                status.config(text=f"{len(res)} match(es)" + (" — showing first 200" if len(res) >= 200 else ""))

        def jump(event=None):
            sel = results_list.curselection()
            if not sel:
                return
            r = state["results"][sel[0]]
            if r["type"] == "dir":
                self._select_tree_node(r["rel"])
            else:
                self._reveal_and_select_file(r["rel_dir"], r["name"])
            win.destroy()

        entry.bind("<KeyRelease>", do_search)
        entry.bind("<Return>", jump)
        results_list.bind("<Double-Button-1>", jump)

    # ---------------- Backup / export ----------------
    def export_workspace_zip(self):
        if not self.workspace_path:
            messagebox.showinfo("No workspace", "Open a workspace first.")
            return
        if self.text_dirty and messagebox.askyesno("Unsaved changes", "Save the current file before backing up?"):
            self.save_current_file()

        default_name = f"{self.workspace_path.name}_backup.zip"
        dest = filedialog.asksaveasfilename(
            title="Save Workspace Backup",
            defaultextension=".zip",
            initialfile=default_name,
            filetypes=[("Zip archive", "*.zip")],
        )
        if not dest:
            return

        dest_path = Path(dest)
        base_no_ext = str(dest_path.with_suffix(""))
        try:
            # Zips the entire workspace folder — every product, every nested
            # sub-product, every file, and each file's formatting sidecar —
            # as a single top-level folder inside the archive.
            archive_path = Path(shutil.make_archive(
                base_no_ext, "zip",
                root_dir=str(self.workspace_path.parent),
                base_dir=self.workspace_path.name,
            ))
            if archive_path != dest_path:
                shutil.move(str(archive_path), str(dest_path))
        except Exception as e:
            messagebox.showerror("Backup failed", str(e))
            return
        messagebox.showinfo("Backup complete", f"Entire workspace backed up to:\n{dest_path}")

    def on_close(self):
        if self.text_dirty:
            if messagebox.askyesno("Unsaved changes", "Save changes before closing?"):
                self.save_current_file()
        save_config(self.config_data)
        self.destroy()


if __name__ == "__main__":
    app = WorkspaceApp()
    app.mainloop()
